# Server-only. Copy to .env; never use a VITE_ prefix for secrets.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=replace-locally
DB_NAME=portfolio
SESSION_SECRET=replace-with-at-least-32-random-characters
# Number of trusted reverse proxies; confirm with hosting before enabling.
TRUST_PROXY=0
